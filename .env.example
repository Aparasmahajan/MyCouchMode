# YouTube Data API v3 key (server-side only, used by /api/yt-search).
# Create one at https://console.cloud.google.com/apis/credentials and enable "YouTube Data API v3".
YOUTUBE_API_KEY=

# Password for the admin page at /admin (onboarding sites).
ADMIN_PASSWORD=

# Shared storage for the site list, so every TV sees what the admin adds.
# In Vercel: Storage -> Create Database -> Upstash for Redis -> connect. Vercel fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=
