# Copy to .env for local development. In production, set these in Vercel → Settings → Environment Variables.

# Password for the admin page at /admin.
ADMIN_PASSWORD=

# --- Storage option A: Google Sheet (recommended) ---------------------------
# Sheet ID from docs.google.com/spreadsheets/d/<THIS-PART>/edit
GOOGLE_SHEET_ID=
# From the service account's JSON key file: "client_email" and "private_key".
# Share the sheet with GOOGLE_SA_EMAIL as Editor.
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=

# --- Storage option B: Upstash Redis (Vercel Storage → Upstash for Redis) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# YouTube Data API v3 key. Optional here: you can also paste it on /admin → YouTube,
# which stores it in the sheet's private "Settings" tab and takes priority over this.
YOUTUBE_API_KEY=
# Optional two-letter country for search results, e.g. IN
YOUTUBE_REGION=
